      ];

      // 2. RENDERIZADOR DO LEITOR DE LEIS
      const containerArtigos = document.getElementById('artigos-container');
      const inputBusca = document.getElementById('filtro-busca');
      const selectTitulo = document.getElementById('filtro-titulo');
      const contador = document.getElementById('contador-artigos');

      function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function highlightText(text, query) {
        if (!query.trim()) return text.replace(/\n/g, '<br>');
        const escaped = escapeRegExp(query.trim());
        const regex = new RegExp(`(${escaped})`, 'gi');
        const formatted = text.replace(regex, '<mark>$1</mark>');
        return formatted.replace(/\n/g, '<br>');
      }

      function renderArtigos() {
        const query = (inputBusca.value || '').toLowerCase().trim();
        const selectedTit = selectTitulo.value;

        const filtered = artigosChave.filter(item => {
          const matchTitulo = (selectedTit === 'todos') || (item.titulo === selectedTit);
          const matchQuery = !query || 
            item.num.toLowerCase().includes(query) || 
            item.texto.toLowerCase().includes(query) ||
            item.tituloNome.toLowerCase().includes(query);
          return matchTitulo && matchQuery;
        });

        contador.textContent = `Exibindo ${filtered.length} de ${artigosChave.length} artigos-chave`;

        if (filtered.length === 0) {
          containerArtigos.innerHTML = `
            <div style="padding: 2rem; text-align: center; background: var(--surface-subtle); border-radius: 8px; border: 1px dashed var(--border);">
              <p style="margin: 0; font-weight: 600; color: var(--text-muted);">Nenhum artigo encontrado com os critérios de busca especificados.</p>
            </div>
          `;
          return;
        }

        containerArtigos.innerHTML = filtered.map(item => `
          <article class="article-item">
            <div class="article-header">
              <span class="article-num">${item.num}</span>
              <span class="article-tag">${item.tituloNome}</span>
            </div>
            <div class="article-body">
              ${highlightText(item.texto, query)}
            </div>
          </article>
        `).join('');
      }

      inputBusca.addEventListener('input', renderArtigos);
      selectTitulo.addEventListener('change', renderArtigos);
      renderArtigos();

      // 3. ACCORDIONS ACESSÍVEIS (Módulos 2 e 6)
      document.querySelectorAll('.acc-trigger').forEach(trigger => {
        trigger.addEventListener('click', () => {
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
          const panelId = trigger.getAttribute('aria-controls');
          const panel = document.getElementById(panelId);

          if (!panel) return;

          if (isExpanded) {
            trigger.setAttribute('aria-expanded', 'false');
            panel.hidden = true;
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            panel.hidden = false;
          }
        });
      });

      // 4. ABAS PROTEGIDO VS NÃO PROTEGIDO (Módulo 3)
      const tabArt7 = document.getElementById('tab-art7');
      const tabArt8 = document.getElementById('tab-art8');
      const panelArt7 = document.getElementById('panel-art7');
      const panelArt8 = document.getElementById('panel-art8');

      function switchTab(activeBtn, activePanel, inactiveBtn, inactivePanel) {
        activeBtn.setAttribute('aria-selected', 'true');
        inactiveBtn.setAttribute('aria-selected', 'false');
        activePanel.classList.add('active');
        inactivePanel.classList.remove('active');
      }

      tabArt7.addEventListener('click', () => switchTab(tabArt7, panelArt7, tabArt8, panelArt8));
      tabArt8.addEventListener('click', () => switchTab(tabArt8, panelArt8, tabArt7, panelArt7));

      // Teclado para Tabs (ArrowLeft / ArrowRight)
      [tabArt7, tabArt8].forEach(btn => {
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            if (btn === tabArt7) {
              tabArt8.focus();
              tabArt8.click();
            } else {
              tabArt7.focus();
              tabArt7.click();
            }
          }
        });
      });

      // 5. CALCULADORA DO DOMÍNIO PÚBLICO
      const inputAno = document.getElementById('ano-falecimento');
      const sliderAno = document.getElementById('slider-ano');
      const resultadoAno = document.getElementById('resultado-ano');
      const calcExplicacao = document.getElementById('calc-explicacao');
      const badgeStatus = document.getElementById('badge-status');

      // Timeline labels e linha
      const tlMorte = document.getElementById('tl-ano-morte');
      const tlVida = document.getElementById('tl-ano-vida');
      const tlProtecao = document.getElementById('tl-ano-protecao');
      const tlDp = document.getElementById('tl-ano-dp');
      const tlBar = document.getElementById('tl-bar');

      const anoAtual = new Date().getFullYear();

      function updateTimelineLine() {
        const tl = document.querySelector('.timeline');
        const markers = document.querySelectorAll('.timeline-marker');
        if (!tl || !tlBar || markers.length < 2) return;

        const isMobile = window.innerWidth <= 720;
        const firstMarker = markers[0];
        const lastMarker = markers[markers.length - 1];

        const tlRect = tl.getBoundingClientRect();
        const firstRect = firstMarker.getBoundingClientRect();
        const lastRect = lastMarker.getBoundingClientRect();

        if (isMobile) {
          // Linha vertical conectando centro do 1º marcador ao centro do último
          const firstCenterY = (firstRect.top + firstRect.height / 2) - tlRect.top;
          const lastCenterY = (lastRect.top + lastRect.height / 2) - tlRect.top;
          const firstCenterX = (firstRect.left + firstRect.width / 2) - tlRect.left;

          tlBar.style.left = `${firstCenterX}px`;
          tlBar.style.top = `${firstCenterY}px`;
          tlBar.style.width = '3px';
          tlBar.style.height = `${Math.max(0, lastCenterY - firstCenterY)}px`;
          tlBar.style.right = 'auto';
          tlBar.style.bottom = 'auto';
          tlBar.style.transform = 'translateX(-50%)';
        } else {
          // Barra horizontal contínua de 3px centralizada nos marcadores
          const firstCenterX = (firstRect.left + firstRect.width / 2) - tlRect.left;
          const lastCenterX = (lastRect.left + lastRect.width / 2) - tlRect.left;
          const firstCenterY = (firstRect.top + firstRect.height / 2) - tlRect.top;

          tlBar.style.left = `${firstCenterX}px`;
          tlBar.style.top = `${firstCenterY}px`;
          tlBar.style.width = `${Math.max(0, lastCenterX - firstCenterX)}px`;
          tlBar.style.height = '3px';
          tlBar.style.right = 'auto';
          tlBar.style.bottom = 'auto';
          tlBar.style.transform = 'translateY(-50%)';
        }
      }

      function updateCalculadora(anoMorte) {
        const morte = parseInt(anoMorte, 10);
        if (isNaN(morte) || morte < 1) return;

        // Art. 41: 70 anos contados de 1º de janeiro do ano subsequente
        // Ano subsequente = morte + 1. 70 anos decorrem ao fim de (morte + 70).
        // A obra cai em domínio público no primeiro dia após o prazo: 1º de janeiro de (morte + 71).
        const anoDP = morte + 71;
        const anoFimProtecao = morte + 70;
        const anoInicioProtecao = morte + 1;

        resultadoAno.textContent = `1º de janeiro de ${anoDP}`;
        calcExplicacao.textContent = `Regra do art. 41: Ano do óbito (${morte}) + 70 anos a contar de 01/01/${anoInicioProtecao} = Domínio público em 01/01/${anoDP}.`;

        if (anoAtual >= anoDP) {
          badgeStatus.textContent = "Já em Domínio Público";
          badgeStatus.className = "status-pill status-public";
        } else {
          const anosFaltantes = anoDP - anoAtual;
          badgeStatus.textContent = `Protegida por mais ~${anosFaltantes} ano(s)`;
          badgeStatus.className = "status-pill status-protected";
        }

        // Timeline sync com as especificações textuais
        tlVida.textContent = `até ${morte}`;
        tlMorte.textContent = `${morte}`;
        tlProtecao.textContent = `${anoInicioProtecao} a ${anoFimProtecao}`;
        tlDp.textContent = `a partir de 01/01/${anoDP}`;

        // Atualiza geometria da linha contínua
        requestAnimationFrame(updateTimelineLine);
      }

      window.addEventListener('resize', updateTimelineLine);

      inputAno.addEventListener('input', (e) => {
        const val = e.target.value;
        sliderAno.value = val;
        updateCalculadora(val);
      });

      sliderAno.addEventListener('input', (e) => {
        const val = e.target.value;
        inputAno.value = val;
        updateCalculadora(val);
      });

      // Inicializa calculadora
      updateCalculadora(inputAno.value);
    });
  </script>
<script>
/* Skip artifact shell — fixed helpers served beside every artifact. */
(function () {
  "use strict";

  var fmt = {
    num: function (v, opts) { return new Intl.NumberFormat("pt-BR", opts || {}).format(v); },
    brl: function (v) { return new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(v); },
    pct: function (v) { return new Intl.NumberFormat("pt-BR", { style: "percent", maximumFractionDigits: 1 }).format(v); }
  };

  // axisFmt keeps axis tick labels short (compact notation) so long values
  // (e.g. full BRL amounts) never clip against the plot edge.
  function axisFmt(v) {
    return fmt.num(v, { notation: "compact", maximumFractionDigits: 1 });
  }

  // format accepts a function OR one of the fmt names ("num" | "brl" | "pct").
  function coerceFormat(spec) {
    if (typeof spec === "function") return spec;
    if (typeof spec === "string" && fmt[spec]) return fmt[spec];
    return function (v) { return fmt.num(v); };
  }

  function accent() {
    return getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#2563eb";
  }
  function mutedColor() {
    return getComputedStyle(document.documentElement).getPropertyValue("--text-muted").trim() || "#5b6472";
  }
  function svgEl(tag, attrs) {
    var el = document.createElementNS("http://www.w3.org/2000/svg", tag);
    for (var k in attrs) el.setAttribute(k, attrs[k]);
    return el;
  }
  function frame(el, w, h) {
    var svg = svgEl("svg", { viewBox: "0 0 " + w + " " + h, role: "img" });
    el.innerHTML = "";
    el.appendChild(svg);
    return svg;
  }

  // maxOf guards the axis scale: empty values would give -Infinity (truthy,
  // so "|| 1" can't catch it) and a non-positive max would flip the chart.
  function maxOf(values) {
    var m = values.length ? Math.max.apply(null, values) : 0;
    return m > 0 ? m : 1;
  }

  // bar(el, {labels:[], values:[], color?, format?}) — vertical bar chart.
  function bar(el, cfg) {
    var W = 640, H = 280, padL = 46, padB = 30, padT = 12;
    var svg = frame(el, W, H);
    var max = maxOf(cfg.values);
    var n = cfg.values.length;
    var plotW = W - padL - 12, plotH = H - padT - padB;
    var step = plotW / n, bw = Math.min(step * 0.62, 64);
    var color = cfg.color || accent();
    var f = coerceFormat(cfg.format);
    for (var g = 0; g <= 4; g++) {
      var gy = padT + plotH - (plotH * g) / 4;
      svg.appendChild(svgEl("line", { x1: padL, y1: gy, x2: W - 12, y2: gy, stroke: "currentColor", "stroke-opacity": 0.08 }));
      var lbl = svgEl("text", { x: padL - 8, y: gy + 4, "text-anchor": "end", "font-size": 10, fill: mutedColor() });
      lbl.textContent = axisFmt((max * g) / 4);
      svg.appendChild(lbl);
    }
    cfg.values.forEach(function (v, i) {
      var bh = Math.max(0, (v / max) * plotH);
      var x = padL + i * step + (step - bw) / 2;
      var y = padT + plotH - bh;
      var r = svgEl("rect", { x: x, y: y, width: bw, height: bh, rx: 4, fill: color });
      var t = svgEl("title", {});
      t.textContent = cfg.labels[i] + ": " + f(v);
      r.appendChild(t);
      svg.appendChild(r);
      var tx = svgEl("text", { x: x + bw / 2, y: H - 10, "text-anchor": "middle", "font-size": 11, fill: mutedColor() });
      tx.textContent = cfg.labels[i];
      svg.appendChild(tx);
    });
  }

  // line(el, {labels:[], values:[], color?, format?}) — single-series line.
  function line(el, cfg) {
    var W = 640, H = 280, padL = 46, padB = 30, padT = 12;
    var svg = frame(el, W, H);
    var max = maxOf(cfg.values);
    var n = cfg.values.length;
    var plotW = W - padL - 16, plotH = H - padT - padB;
    var color = cfg.color || accent();
    var f = coerceFormat(cfg.format);
    for (var g = 0; g <= 4; g++) {
      var gy = padT + plotH - (plotH * g) / 4;
      svg.appendChild(svgEl("line", { x1: padL, y1: gy, x2: W - 16, y2: gy, stroke: "currentColor", "stroke-opacity": 0.08 }));
      var lbl = svgEl("text", { x: padL - 8, y: gy + 4, "text-anchor": "end", "font-size": 10, fill: mutedColor() });
      lbl.textContent = axisFmt((max * g) / 4);
      svg.appendChild(lbl);
    }
    var pts = cfg.values.map(function (v, i) {
      var x = padL + (n === 1 ? plotW / 2 : (plotW * i) / (n - 1));
      var y = padT + plotH - (v / max) * plotH;
      return [x, y];
    });
    var d = pts.map(function (p, i) { return (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1); }).join(" ");
    svg.appendChild(svgEl("path", { d: d, fill: "none", stroke: color, "stroke-width": 2, "stroke-linejoin": "round" }));
    pts.forEach(function (p, i) {
      var c = svgEl("circle", { cx: p[0], cy: p[1], r: 3.5, fill: color });
      var t = svgEl("title", {});
      t.textContent = cfg.labels[i] + ": " + f(cfg.values[i]);
      c.appendChild(t);
      svg.appendChild(c);
      var tx = svgEl("text", { x: p[0], y: H - 10, "text-anchor": "middle", "font-size": 11, fill: mutedColor() });
      tx.textContent = cfg.labels[i];
      svg.appendChild(tx);
    });
  }

  // donut(el, {labels:[], values:[], colors?}) — donut with center total.
  function donut(el, cfg) {
    var W = 320, H = 280, cx = W / 2, cy = H / 2, R = 92, r = 58;
    var svg = frame(el, W, H);
    var total = cfg.values.reduce(function (a, b) { return a + b; }, 0) || 1;
    var palette = cfg.colors || [accent(), "#1baf7a", "#eda100", "#e34948", "#4a3aa7", "#e87ba4"];
    var a0 = -Math.PI / 2;
    cfg.values.forEach(function (v, i) {
      var a1 = a0 + (v / total) * Math.PI * 2;
      var large = a1 - a0 > Math.PI ? 1 : 0;
      var p = ["M", cx + R * Math.cos(a0), cy + R * Math.sin(a0),
        "A", R, R, 0, large, 1, cx + R * Math.cos(a1), cy + R * Math.sin(a1),
        "L", cx + r * Math.cos(a1), cy + r * Math.sin(a1),
        "A", r, r, 0, large, 0, cx + r * Math.cos(a0), cy + r * Math.sin(a0), "Z"].join(" ");
      var path = svgEl("path", { d: p, fill: palette[i % palette.length] });
      var t = svgEl("title", {});
      t.textContent = cfg.labels[i] + ": " + fmt.num(v) + " (" + fmt.pct(v / total) + ")";
      path.appendChild(t);
      svg.appendChild(path);
      a0 = a1;
    });
    var center = svgEl("text", { x: cx, y: cy + 5, "text-anchor": "middle", "font-size": 20, "font-weight": 650, fill: "currentColor" });
    center.textContent = fmt.num(total);
    svg.appendChild(center);
  }

  window.skipShell = { fmt: fmt };
  window.skipChart = { bar: bar, line: line, donut: donut };
})();

</script>
