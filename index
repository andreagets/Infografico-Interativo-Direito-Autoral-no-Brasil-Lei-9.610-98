  <style>
/* Skip artifact shell — fixed styles served beside every artifact.
   Complements basecoat; artifacts override --accent for their own identity. */
:root {
  color-scheme: light dark;
  --accent: #2563eb;
  --accent-contrast: #ffffff;
  --accent-text: color-mix(in srgb, var(--accent) 72%, #000);
  --bg: #f8f9fb;
  --surface: #ffffff;
  --text: #14171f;
  --text-muted: #5b6472;
  --border: rgba(20, 23, 31, 0.10);
  --radius: 10px;
  --shadow: 0 1px 3px rgba(20, 23, 31, 0.08);
  --space: 16px;
}
/* Theme resolution. Without data-theme the viewer's system preference decides,
   as it always did. With it, the artifact's own choice wins in BOTH directions:
   a page that hardcodes one palette must not be handed the opposite set of
   tokens by the machine it happens to be opened on. The dark values appear
   twice because a media query cannot be folded into a selector list.
   The attribute sits inside :where() so these blocks keep the specificity of a
   bare :root — the page's own <style> is linked after this file and must go on
   overriding any token it wants, exactly as it could before. */
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    --accent-text: color-mix(in srgb, var(--accent) 78%, #fff);
    --bg: #101318;
    --surface: #181c23;
    --text: #eef1f6;
    --text-muted: #9aa4b2;
    --border: rgba(238, 241, 246, 0.12);
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }
}
:root:where([data-theme="dark"]) {
  color-scheme: dark;
  --accent-text: color-mix(in srgb, var(--accent) 78%, #fff);
  --bg: #101318;
  --surface: #181c23;
  --text: #eef1f6;
  --text-muted: #9aa4b2;
  --border: rgba(238, 241, 246, 0.12);
  --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
}
:root:where([data-theme="light"]) { color-scheme: light; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }

.shell-container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
.shell-section { padding: calc(var(--space) * 2) 0; }
.shell-grid { display: grid; gap: var(--space); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.shell-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: var(--space); }
.shell-footer { padding: 24px 0 40px; color: var(--text-muted); font-size: 13px; }

.shell-hero { padding: calc(var(--space) * 3) 0 calc(var(--space) * 2); }
.shell-hero h1 { font-size: clamp(26px, 4vw, 40px); line-height: 1.15; margin: 0 0 10px; text-wrap: balance; }
.shell-hero p { color: var(--text-muted); max-width: 60ch; margin: 0; }

.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--space);
}

.kpi { display: flex; flex-direction: column; gap: 4px; }
.kpi .kpi-value { font-size: 28px; font-weight: 650; line-height: 1.1; }
.kpi .kpi-label { font-size: 13px; color: var(--text-muted); }
.kpi .kpi-delta { font-size: 12.5px; font-weight: 600; }
.kpi .kpi-delta.up { color: #0a8f3c; }
.kpi .kpi-delta.down { color: #cf3131; }

table.shell-table { border-collapse: collapse; width: 100%; font-size: 14px; }
table.shell-table th {
  text-align: left; font-size: 11.5px; letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--text-muted); font-weight: 600;
}
table.shell-table th, table.shell-table td { padding: 9px 12px 9px 0; border-bottom: 1px solid var(--border); }
table.shell-table td.num, table.shell-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.shell-table tbody tr:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }

.chart-box { width: 100%; min-height: 220px; }
.chart-box svg { width: 100%; height: auto; display: block; }

.muted { color: var(--text-muted); }
.accent { color: var(--accent-text); }
.shell-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent-text);
}

@media (prefers-reduced-motion: no-preference) {
  .shell-fade { animation: shell-fade 400ms ease both; }
  @keyframes shell-fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
}

</style>
  
  <style>
    :root {
      --accent: #C9A227;
      --accent-text: #8A6805;
      --accent-contrast: #14213D;
      --bg: #F7F5F1;
      --surface: #FFFFFF;
      --surface-subtle: #F0EDE6;
      --text: #14213D;
      --text-muted: #475569;
      --border: #D8D2C4;
      --teal: #146C60;
      --teal-light: #E6F3F1;
      --teal-dark: #0D4941;
      --alert: #9B2C2C;
      --alert-light: #FDE8E8;
      --navy: #14213D;
      --navy-dark: #0B1324;
      --radius: 10px;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    h1, h2, h3, .serif-heading {
      font-family: Georgia, Cambria, "Times New Roman", Times, serif;
      color: var(--text);
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    /* Top Banner / Header */
    .site-header {
      background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 100%);
      color: #FFFFFF;
      padding: 2.75rem 1.25rem 2.25rem;
      border-bottom: 4px solid var(--accent);
    }
    .site-header h1 {
      color: #FFFFFF;
      font-size: clamp(1.8rem, 4vw, 2.75rem);
      margin: 0 0 0.5rem;
      line-height: 1.15;
    }
    .site-header .subtitle {
      color: #E2E8F0;
      font-size: 1.15rem;
      font-weight: 400;
      margin: 0 0 1rem;
    }
    .site-header .tag-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(201, 162, 39, 0.2);
      border: 1px solid var(--accent);
      color: #F8E392;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.825rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .site-header-inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      justify-items: center;
      text-align: center;
    }
    .site-header-inner > div {
      grid-row: 2;
      max-width: 850px;
    }
    .site-header-logo {
      grid-row: 1;
      width: min(100%, 420px);
      max-height: 150px;
      height: auto;
      object-fit: contain;
      object-position: center;
      margin: 0 auto;
    }
    @media (max-width: 700px) {
      .site-header-inner {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .site-header-logo {
        width: min(100%, 300px);
        max-height: 96px;
      }
    }

    /* Sticky Navigation */
    .sticky-nav {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(247, 245, 241, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 0;
    }
    .nav-track {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.25rem 1rem;
      scrollbar-width: thin;
    }
    .nav-link {
      white-space: nowrap;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      color: var(--navy);
      text-decoration: none;
      background: var(--surface);
      border: 1px solid var(--border);
      transition: all 0.2s ease;
    }
    .nav-link:hover, .nav-link:focus-visible {
      background: var(--teal);
      color: #FFFFFF;
      border-color: var(--teal);
      outline: 2px solid var(--teal);
    }

    /* Cards & Panels */
    .module-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 6px rgba(20, 33, 61, 0.04);
    }
    .module-title {
      font-size: 1.55rem;
      margin-top: 0;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--navy);
    }
    .module-num {
      background: var(--teal-light);
      color: var(--teal);
      font-size: 0.85rem;
      font-family: system-ui, sans-serif;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      border: 1px solid rgba(20, 108, 96, 0.25);
    }
    .module-desc {
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      font-size: 0.975rem;
    }

    /* Metric Badges */
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
    }
    .metric-box {
      background: var(--surface-subtle);
      border-left: 4px solid var(--accent);
      padding: 1rem 1.25rem;
      border-radius: 0 8px 8px 0;
    }
    .metric-value {
      font-size: 2rem;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.1;
      font-family: Georgia, serif;
    }
    .metric-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 0.25rem;
    }

    /* Accordion Custom */
    .acc-item {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 0.65rem;
      background: var(--surface);
      overflow: hidden;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .acc-item:focus-within {
      border-color: var(--teal);
    }
    .acc-trigger {
      width: 100%;
      text-align: left;
      padding: 0.95rem 1.25rem;
      background: none;
      border: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1rem;
      font-weight: 600;
      color: var(--navy);
      cursor: pointer;
      font-family: inherit;
    }
    .acc-trigger:hover {
      background: var(--surface-subtle);
    }
    .acc-trigger[aria-expanded="true"] {
      background: var(--teal-light);
      color: var(--teal-dark);
      border-bottom: 1px solid rgba(20, 108, 96, 0.2);
    }
    .acc-icon {
      font-size: 1.25rem;
      font-weight: bold;
      transition: transform 0.25s ease;
      color: var(--teal);
    }
    .acc-trigger[aria-expanded="true"] .acc-icon {
      transform: rotate(45deg);
    }
    .acc-panel {
      padding: 1rem 1.25rem;
      font-size: 0.925rem;
      line-height: 1.55;
      background: #FAFAFA;
      color: var(--text);
    }
    .acc-panel[hidden] {
      display: none;
    }

    /* Tabs Component */
    .tab-nav {
      display: flex;
      gap: 0.5rem;
      border-bottom: 2px solid var(--border);
      margin-bottom: 1.25rem;
    }
    .tab-btn {
      padding: 0.65rem 1.25rem;
      font-size: 0.95rem;
      font-weight: 700;
      border: none;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: inherit;
    }
    .tab-btn[aria-selected="true"] {
      color: var(--navy);
      border-bottom-color: var(--teal);
    }
    .tab-btn:focus-visible {
      outline: 2px solid var(--teal);
      border-radius: 4px;
    }
    .tab-panel {
      display: none;
    }
    .tab-panel.active {
      display: block;
    }

    /* Protected / Not Protected Grid */
    .inciso-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.85rem;
    }
    .inciso-card {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.85rem 1rem;
      background: var(--surface);
      position: relative;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .inciso-card:hover {
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
      transform: translateY(-2px);
    }
    .inciso-card.protected {
      border-left: 4px solid var(--teal);
    }
    .inciso-card.unprotected {
      border-left: 4px solid var(--alert);
    }
    .inciso-badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 0.4rem;
    }
    .inciso-card.protected .inciso-badge {
      background: var(--teal-light);
      color: var(--teal-dark);
    }
    .inciso-card.unprotected .inciso-badge {
      background: var(--alert-light);
      color: var(--alert);
    }
    .inciso-tooltip {
      font-size: 0.825rem;
      color: var(--text-muted);
      margin-top: 0.35rem;
      border-top: 1px dashed var(--border);
      padding-top: 0.4rem;
      font-style: italic;
    }

    /* Moral vs Patrimonial 2 Columns */
    .split-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    @media (max-width: 768px) {
      .split-columns {
        grid-template-columns: 1fr;
      }
    }
    .col-card {
      border-radius: 8px;
      padding: 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
    }
    .col-card.moral {
      border-top: 4px solid var(--teal);
    }
    .col-card.patrimonial {
      border-top: 4px solid var(--accent);
    }
    .col-header {
      font-size: 1.2rem;
      font-weight: 700;
      margin-top: 0;
      margin-bottom: 0.25rem;
      font-family: Georgia, serif;
    }
    .highlight-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      font-size: 0.775rem;
      font-weight: 700;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    .moral .highlight-badge {
      background: var(--teal-light);
      color: var(--teal-dark);
    }
    .patrimonial .highlight-badge {
      background: #FDF4D8;
      color: #795700;
    }
    .feature-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .feature-list li {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--surface-subtle);
      font-size: 0.925rem;
      display: flex;
      gap: 0.6rem;
    }
    .feature-list li:last-child {
      border-bottom: none;
    }
    .feature-tag {
      font-weight: 700;
      color: var(--navy);
      min-width: 58px;
      font-size: 0.8rem;
    }

    /* Calculator & Timeline */
    .calc-box {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
    }
    .calc-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    .calc-input-wrap {
      flex: 1 1 200px;
    }
    .calc-slider-wrap {
      flex: 2 1 260px;
    }
    .calc-result-banner {
      background: var(--navy);
      color: #FFFFFF;
      padding: 1.25rem;
      border-radius: 8px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }
    .calc-status {
      font-size: 1.1rem;
      font-weight: 700;
    }
    .status-pill {
      display: inline-block;
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.85rem;
    }
    .status-protected {
      background: #2D3748;
      color: #F8E392;
      border: 1px solid var(--accent);
    }
    .status-public {
      background: var(--teal);
      color: #FFFFFF;
    }

    /* Timeline Vis — Linha do Tempo Domínio Público */
    .timeline {
      position: relative;
      box-sizing: border-box;
      width: 100%;
      height: 165px;
      min-height: 150px;
      max-height: 180px;
      padding: 16px;
      margin: 1.75rem 0 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      align-items: center;
      overflow: hidden;
    }
    .timeline-bar {
      position: absolute;
      height: 3px;
      background: var(--teal);
      z-index: 1;
      border-radius: 2px;
      transition: width 0.25s ease, height 0.25s ease, left 0.25s ease, top 0.25s ease;
    }
    .timeline-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      z-index: 2;
      height: 100%;
      justify-content: space-between;
      padding: 0 4px;
      box-sizing: border-box;
    }
    .timeline-label {
      font-size: 13px;
      font-weight: 600;
      color: #14213D;
      line-height: 1.3;
      text-align: center;
      margin-bottom: 12px;
      height: 34px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      word-break: normal;
      overflow-wrap: break-word;
      white-space: normal;
    }
    .timeline-marker-box {
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .timeline-marker {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: inline-block;
      cursor: pointer;
      box-sizing: border-box;
      flex-shrink: 0;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      outline: none;
    }
    .timeline-marker.teal-fill {
      background: var(--teal);
      border: none;
    }
    .timeline-marker.gold-ring {
      background: #FFFFFF;
      border: 3px solid var(--accent);
    }
    .timeline-marker:hover {
      transform: scale(1.2);
    }
    .timeline-marker:focus-visible {
      outline: 3px solid #14213D;
      outline-offset: 3px;
    }
    .timeline-date {
      font-size: 12px;
      color: #5A6472;
      line-height: 1.3;
      text-align: center;
      margin-top: 12px;
      height: 32px;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      word-break: normal;
      overflow-wrap: break-word;
      white-space: normal;
    }

    @media (max-width: 720px) {
      .timeline {
        display: flex;
        flex-direction: column;
        gap: 20px;
        height: auto;
        min-height: 0;
        max-height: none;
        padding: 16px 16px 16px 0;
        overflow: visible;
      }
      .timeline-step {
        display: grid;
        grid-template-columns: 40px 1fr;
        grid-template-rows: auto auto;
        column-gap: 12px;
        row-gap: 3px;
        align-items: center;
        text-align: left;
        height: auto;
        justify-content: flex-start;
        width: 100%;
        padding: 0;
      }
      .timeline-marker-box {
        grid-column: 1;
        grid-row: 1 / span 2;
        width: 40px;
        min-width: 40px;
        height: auto;
        align-self: center;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
        box-sizing: border-box;
      }
      .timeline-label {
        grid-column: 2;
        grid-row: 1;
        height: auto;
        margin-bottom: 0;
        text-align: left;
        justify-content: flex-start;
        align-items: center;
        line-height: 1.35;
      }
      .timeline-date {
        grid-column: 2;
        grid-row: 2;
        height: auto;
        margin-top: 0;
        text-align: left;
        justify-content: flex-start;
        align-items: center;
        line-height: 1.35;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .timeline-marker,
      .timeline-bar {
        transition: none !important;
        animation: none !important;
      }
    }

    /* Sanctions Indicator KPIs */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
    }
    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      text-align: center;
    }
    .kpi-card .number {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--teal);
      font-family: Georgia, serif;
      line-height: 1.2;
    }
    .kpi-card .caption {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
